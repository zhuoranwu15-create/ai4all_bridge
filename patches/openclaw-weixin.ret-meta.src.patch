+/**
+ * Lift the iLink business-level fields (`ret`/`errcode`/`errmsg`) from a
+ * sendmessage response into a `meta` bag so they survive to outbound callers.
+ *
+ * HTTP status is 200 whether iLink accepts (`{}`) or rejects (`{"ret":-2}`), so
+ * these fields are the only signal for downstream acceptance. Core forwards this
+ * bag verbatim via the gateway send result's `meta` dock (OutboundDeliveryResult.meta),
+ * letting ai4all distinguish real acceptance from a soft reject. Returns
+ * undefined when the response carried no business signal (accept `{}`), so the
+ * normal success path adds no meta and its behavior is unchanged.
+ */
+function buildSendResultMeta(resp: SendMessageResp | undefined | null): Record<string, unknown> | undefined {
+  if (!resp) return undefined;
+  const meta: Record<string, unknown> = {};
+  if (resp.ret !== undefined) meta.ret = resp.ret;
+  if (resp.errcode !== undefined) meta.errcode = resp.errcode;
+  if (resp.errmsg !== undefined) meta.errmsg = resp.errmsg;
+  return Object.keys(meta).length ? meta : undefined;
+}
