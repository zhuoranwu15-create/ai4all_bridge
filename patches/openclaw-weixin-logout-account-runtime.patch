+            // 单账号本地登出。OpenClaw core 在调本方法前已执行 stopChannel
+            // （触发 stopAccount/notifyStop 停掉 webhook），故这里只清本地凭证/状态，不影响其他账号。
+            const accountId = ctx.accountId;
