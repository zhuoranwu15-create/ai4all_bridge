+            if (!accountId) {
+                return { cleared: false, loggedOut: false };
+            }
+            const normalizedId = normalizeAccountId(accountId);
+            const candidates = new Set([accountId, normalizedId]);
+            const rawId = deriveRawAccountId(normalizedId);
+            if (rawId)
+                candidates.add(rawId);
+            let cleared = false;
+            for (const id of candidates) {
+                try {
+                    clearWeixinAccount(id);
+                    unregisterWeixinAccountId(id);
+                    clearContextTokensForAccount(id);
+                    cleared = true;
+                }
+                catch (err) {
+                    aLog.warn(`gateway.logoutAccount: cleanup failed id=${id} err=${String(err)}`);
+                }
+            }
+            try {
+                await triggerWeixinChannelReload();
+            }
+            catch (err) {
+                aLog.warn(`gateway.logoutAccount: channel reload failed err=${String(err)}`);
+            }
+            aLog.info(`gateway.logoutAccount: local logout done accountId=${normalizedId} cleared=${cleared}`);
+            return { cleared, loggedOut: cleared };
