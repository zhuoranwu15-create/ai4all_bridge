AI4ALL_BRIDGE_SECRET=dev-secret
ADMIN_TOKEN=dev-admin-token
ADMIN_STAFF_TOKEN=
ADMIN_DEBUG_PLAINTEXT_ENABLED=false
ADMIN_DEBUG_PLAINTEXT_ACCOUNT_ALLOWLIST=
APP_ENV=local
DATABASE_PATH=data/ai4all.sqlite3

# OpenAI-compatible chat completions API. Leave LLM_API_KEY empty to keep mock fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1
LLM_FORCE_IPV4=true
LLM_CONTEXT_MESSAGES=12

# Web search. DuckDuckGo requires no API key, but may be unavailable on some
# local networks; bing uses Bing RSS and also requires no API key.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_DEFAULT_PROVIDER=duckduckgo
WEB_SEARCH_PROVIDER_ORDER=duckduckgo,bing
WEB_SEARCH_PROVIDER_FAILOVER=true
WEB_SEARCH_SYNC_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TRACE_RAW_RESPONSE=false

# Aliyun IQS web search. Uses the cloud-iqs.aliyuncs.com unified search API.
DASHSCOPE_API_KEY=
ALIYUN_WEB_SEARCH_API_KEY=
ALIYUN_WEB_SEARCH_ENABLED=false
ALIYUN_WEB_SEARCH_BASE_URL=https://cloud-iqs.aliyuncs.com/search/unified
ALIYUN_WEB_SEARCH_ENGINE_TYPE=LiteAdvanced
ALIYUN_WEB_SEARCH_MODEL=qwen-plus
ALIYUN_WEB_SEARCH_FORCED=true
ALIYUN_WEB_SEARCH_ENABLE_SOURCE=true
ALIYUN_WEB_SEARCH_STRATEGY=

# Baidu AI Search. Requires an AppBuilder API key.
BAIDU_AI_SEARCH_ENABLED=false
BAIDU_AI_SEARCH_API_KEY=
BAIDU_AI_SEARCH_BASE_URL=https://qianfan.baidubce.com
BAIDU_AI_SEARCH_ENDPOINT=/v2/ai_search/web_search
BAIDU_AI_SEARCH_SOURCE=baidu_search_v2
BAIDU_AI_SEARCH_TOP_K=5

RATE_LIMIT_DAILY=100
RATE_LIMIT_RPM=5
RATE_LIMIT_DAILY_MESSAGE=今天聊得有点多了，我晚些时候再继续陪你。
RATE_LIMIT_RPM_MESSAGE=消息来得太快了，稍等一下再发我吧。

# Local development only: comma-separated account ids that should store full prompt traces.
DEBUG_TRACE_ACCOUNT_IDS=

# Main conversation session lifecycle.
CONVERSATION_SESSION_MAX_TURNS=500
CONVERSATION_SESSION_BUSINESS_DAY_START_HOUR=4

# Web onboarding -> OpenClaw QR login.
OPENCLAW_LOGIN_AUTO_START=true
OPENCLAW_LOGIN_START_TIMEOUT_MS=35000
OPENCLAW_LOGIN_WAIT_TIMEOUT_MS=480000
OPENCLAW_GATEWAY_CALL_TIMEOUT_MS=60000

# Proactive outbound / scheduler. Keep scheduler disabled unless FastAPI runs
# with one worker or a separate worker process runs scripts/run_proactive_scheduler.py.
PROACTIVE_OUTBOUND_ENABLED=true
PROACTIVE_OUTBOUND_DAILY_LIMIT=3
PROACTIVE_QUIET_HOURS_START=22:00
PROACTIVE_QUIET_HOURS_END=08:00
PROACTIVE_SCHEDULER_ENABLED=false
PROACTIVE_SCHEDULER_INTERVAL_SECONDS=30
PROACTIVE_SCHEDULER_BATCH_SIZE=20
PROACTIVE_SCHEDULER_BYPASS_QUIET_HOURS=false
PROACTIVE_ACCOUNT_SCAN_INTERVAL_SECONDS=3600
PROACTIVE_HEARTBEAT_CANDIDATE_CONTEXT_MESSAGES=12
PROACTIVE_HEARTBEAT_CANDIDATE_MIN_CONFIDENCE=0.85
PROACTIVE_COMMITMENT_EXTRACTION_ENABLED=true
PROACTIVE_COMMITMENT_CONTEXT_MESSAGES=8
PROACTIVE_COMMITMENT_MIN_CONFIDENCE=0.9
PROACTIVE_COMMITMENT_MAX_DAYS=14

# Aliyun SMS (短信)
# Empty credentials enable mock mode in local/test only; non-local environments
# fail closed when Aliyun SMS/Captcha config is missing.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_MAX_PER_PHONE_PER_HOUR=5

# Aliyun Captcha 2.0 (验证码)
# ALIYUN_CAPTCHA_SCENE_ID and ALIYUN_CAPTCHA_PREFIX are obtained from
# the Aliyun Captcha 2.0 console.
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=

# OTP TTL
OTP_EXPIRES_MINUTES=10
OTP_TOKEN_EXPIRES_MINUTES=10
