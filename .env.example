# AI4ALL Weixin Bot — 环境配置模板
# 复制为 .env 并填写真实值，不要提交 .env。
# 未列出的参数均已在 app/config.py 中设有生产安全的默认值，只在需要偏离时添加。

# ===== 必须设置（密钥 / 凭据）=====
AI4ALL_BRIDGE_SECRET=dev-secret         # 生产必须改为随机长字符串
ADMIN_TOKEN=dev-admin-token             # 生产必须改为随机长字符串
ADMIN_STAFF_TOKEN=
ADMIN_REVIEWER_TOKEN=                  # 人工审核员 token；只能访问 moderation 队列和详情
LLM_API_KEY=                            # 留空则使用 mock 回退（仅 local/test）
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_WEBSITE_WEBHOOK_URL=
FEISHU_ERROR_LOG_ALERT_ENABLED=true      # true 时 ai4all.* ERROR/exception 日志会推送 FEISHU_ALERT_WEBHOOK_URL
FEISHU_ERROR_LOG_ALERT_MIN_INTERVAL_SECONDS=300  # 同类错误日志飞书报警冷却时间，避免刷屏
FEISHU_ERROR_LOG_ALERT_TIMEOUT_SECONDS=3.0       # 推送飞书 webhook 的请求超时（秒），最小 0.5
FEISHU_ERROR_LOG_ALERT_MAX_CHARS=3500            # 单条报警最大字符数，超出截断，最小 500

# ===== 部署拓扑（每个环境必须明确设置）=====
APP_ENV=local

# ===== Plum Chat Web MVP（开发态固定测试账号）=====
PLUM_ENABLED=true
PLUM_DEV_MODE=true                    # 仅 local/development/test 生效；生产始终 fail closed
PLUM_TEST_USER_ID=user_plum_test
PLUM_TEST_PHONE=plum-test@local.invalid
PLUM_FAST_PROVIDER_ID=deepseek
PLUM_BALANCED_PROVIDER_ID=chatgpt
PLUM_IMMERSIVE_PROVIDER_ID=deepseek-v4-pro
PLUM_PUBLIC_TEST_AUTH_ENABLED=true    # 邀请码 + HttpOnly Cookie；公网内测保持 true
PLUM_SESSION_COOKIE_NAME=plum_session
PLUM_CSRF_COOKIE_NAME=plum_csrf
PLUM_SESSION_DAYS=30
PLUM_SESSION_COOKIE_SECURE=false      # 本地 HTTP=false；公网 HTTPS 必须=true
PLUM_CHAT_STREAMING_ENABLED=true      # Plum 默认流式；需应急回退时显式设为 false
PLUM_GUEST_CHAT_ENABLED=false         # Guest 基础能力；完成灰度验收后按环境开启
PLUM_EMAIL_AUTH_ENABLED=false         # 邮件 provider 配置完成前保持关闭
PLUM_EMAIL_OTP_PEPPER=                # 至少 32 字节随机值；不可与其他签名密钥复用
PLUM_EMAIL_OTP_EXPIRES_MINUTES=10
PLUM_EMAIL_OTP_MAX_ATTEMPTS=5
PLUM_EMAIL_OTP_RESEND_SECONDS=60
PLUM_EMAIL_SENDER_MODE=disabled       # disabled | smtp
PLUM_EMAIL_SMTP_HOST=
PLUM_EMAIL_SMTP_PORT=587
PLUM_EMAIL_SMTP_USERNAME=
PLUM_EMAIL_SMTP_PASSWORD=
PLUM_EMAIL_SMTP_FROM=
PLUM_EMAIL_SMTP_STARTTLS=true
PLUM_EMAIL_SMTP_TIMEOUT_SECONDS=10
PLUM_GOOGLE_AUTH_ENABLED=false        # Google OAuth 凭据/redirect 配置完成前保持关闭
PLUM_APPLE_AUTH_ENABLED=false         # V1 保留能力位，默认关闭
PLUM_GUEST_SESSION_COOKIE_NAME=plum_guest_session
PLUM_GUEST_SESSION_DAYS=30
PLUM_GUEST_TYPED_LIMIT=2
PLUM_GUEST_CONTINUE_LIMIT=8
PLUM_GUEST_CHARACTER_CONTINUE_LIMIT=2
PLUM_GUEST_PROVIDER_ID=deepseek
PLUM_GUEST_MAX_OUTPUT_TOKENS=384
# ===== 两层模型选择：family(厂商家族) × tier(pro=综合强 / flash=快) =====
# 主对话和后台任务默认走 active family 的 flash（可用 LLM_TASK_TIERS 逐项改回 pro）。
LLM_BASE_URL=https://api.deepseek.com   # deepseek 家族 base（family=deepseek 的 pro/flash 共用）
LLM_ACTIVE_FAMILY=deepseek              # 默认生效家族：deepseek | openai | anthropic（后台可运行时切）
# LLM_TASK_TIERS={"main_reply":"pro"}   # 可选：逐任务覆盖 tier。当前所有任务默认 flash。
#   task kind: main_reply / onboarding_extraction / moderation / rolling_summary / dreaming /
#              user_meta / relationship_state / proactive_recall / web_completion
LLM_OPENAI_BASE_URL=https://co.yes.vg
LLM_OPENAI_MODEL=gpt-5.5
LLM_OPENAI_API_KEY=                  # 填写第三方代理 key 后，后台可把 active family 切到 openai
LLM_ANTHROPIC_BASE_URL=https://co.yes.vg
LLM_ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_ANTHROPIC_API_KEY=               # 可与 LLM_OPENAI_API_KEY 使用同一个第三方代理 key
# LLM_PROVIDERS_JSON: 可选，声明/新增 family×tier 矩阵条目。每条必须带 family + tier(pro/flash)。
# 覆盖内置 id 时也要显式写 family/tier（不做隐式继承，避免改了 model 忘了 tier 的错配）。
# 内置矩阵已含 deepseek{pro,flash} + openai/anthropic 的 pro（读 LLM_OPENAI_MODEL / LLM_ANTHROPIC_MODEL 等），
# 只想换模型/base 时改上面的 LLM_*_MODEL / LLM_*_BASE_URL 即可，通常无需填本项。
LLM_PROVIDERS_JSON=
PROACTIVE_SCHEDULER_ENABLED=false       # 生产推荐独立进程，保持 false
DREAMING_SCHEDULER_ENABLED=false        # FastAPI 进程内每日 dreaming 扫描；默认关，单例职责已交给 proactive 进程（下行），二者互斥避免重复扫描
# PROACTIVE_DREAMING_SCHEDULER_ENABLED=true  # proactive-scheduler 单例进程内挂 4 点 dreaming 扫描；代码默认 true。若改由 FastAPI 进程承担则设 false
USER_META_SCHEDULER_ENABLED=false       # 用户元属性每日批处理；多实例部署建议独立进程或仅单 worker 开启
USER_META_SCHEDULER_HOUR=3              # 北京时间每日触发小时
USER_META_SCHEDULER_PAGE_SIZE=100       # 每页账号数
USER_META_SCHEDULER_INTER_ACCOUNT_SLEEP=0.5 # 账号间隔秒数，降低 DB/LLM 冲击

# ===== 多机接入（central 大脑 + 瘦 node；见 docs/tech_design/multi_node_access_refactor.md）=====
# 默认 standalone = 今天单机形态，下面除 AI4ALL_ROLE 外都可留空，行为不变。
AI4ALL_ROLE=standalone                  # standalone(默认) | central | node | "central,node"(aliyun1 同机共存)
NODE_ID=                                # 含 node 能力时必填，全局唯一(如 aliyun1 / aliyun2)
DEFAULT_NODE_ID=                        # 账号未分配节点时的兜底归属(迁移期=aliyun1)；standalone 留空
CENTRAL_URL=                            # node→中心 的稳定指纹地址(MVP=http://aliyun1)，不要写裸 IP
NODE_BASE_URL=                          # 本节点基址(中心 push 登录用)，写入 access_nodes(如 http://aliyun2:8190)
NODE_AGENT_HOST=0.0.0.0                 # node agent HTTP 监听地址
NODE_AGENT_PORT=8190                    # node agent HTTP 端口
NODE_MAX_SESSIONS=0                     # 本机会话上限(MVP 仅上报，0=未设)
OUTBOUND_PULL_INTERVAL_SECONDS=2        # 节点出站轮询间隔(秒)
OUTBOUND_PULL_BATCH_SIZE=20             # 节点单轮认领条数
OUTBOUND_CLAIM_TIMEOUT_SECONDS=60       # sending 卡死回收阈值(节点崩溃安全网)
LOCAL_NODE_INLINE_DISPATCH=false        # true: central 同机 node 出站走同进程即时发(迁移期降延迟)

# ===== 主应用 PostgreSQL（见 docs/architecture/shared/data/thick_node_postgres_refactor.md）=====
# 必填；主应用只支持 PostgreSQL，留空或填写非 PostgreSQL URL 会在首次连接时直接失败。
# 本地示例（先运行 make pg-local-up pg-local-init）：
# postgresql://ai4all:ai4all-local@127.0.0.1:55432/ai4all_dev
DATABASE_URL=
DB_POOL_MIN_SIZE=1                      # PG 连接池下限
DB_POOL_MAX_SIZE=8                      # PG 连接池上限；Σ(各节点上限)+中心 ≤ PG max_connections
# 注意：PG 迁移 opt-in 变量 AI4ALL_ALLOW_AUTO_MIGRATE **故意不在本文件里**。
# 它只写进 systemd 单元的 Environment=，或由 make pg-local-init 注入单个子进程；一旦写进
# .env，同目录手跑的 python 进程会一起继承，
# 「未评审的迁移被自测顺手写进生产库」这道闸就形同虚设。见 app/db/_core.py 的 AUTO_MIGRATE_ENV。

# ===== 第三方服务凭据（按需填写）=====
DASHSCOPE_API_KEY=
ALIYUN_WEB_SEARCH_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=

# ===== 调试（生产保持默认关闭）=====
# ADMIN_DEBUG_PLAINTEXT_ENABLED=true
# ADMIN_DEBUG_PLAINTEXT_ACCOUNT_ALLOWLIST=aid_123456789,aid_987654321
# DEBUG_TRACE_ACCOUNT_IDS=aid_123456789
# AI4ALL_SHADOW_TRACE_ACCOUNT_IDS=    # OpenClaw Bridge 侧 shadow trace 账号列表；默认留空，需要时再填

# ===== 可选覆盖（有合理代码默认值，只在需要偏离时取消注释）=====
# LLM_TIMEOUT_SECONDS=20               # 代码默认 50，本地加速用
# LLM_CONTEXT_MESSAGES=12              # 代码默认 100，本地省 token 用（DB 取数条数硬顶）
# LLM_CONTEXT_TOKEN_BUDGET=3000        # 历史 token 预算，仅对话部分；0=关（退回纯条数）。见 docs/tech_design/context_window_token_budget_design.md
# LLM_CONTEXT_MESSAGE_MAX_CHARS=2000   # 单条历史消息字符硬上限，超长截断；0=关
# LLM_HISTORY_TIMESTAMP_ENABLED=true   # 历史 user 轮加绝对时间戳前缀 [周一 2026-07-06 11:39]；代码默认 true，可回滚
# LLM_ROLLING_SUMMARY_ENABLED=true     # Token 压力滚动摘要（统一编排后为核心路径，且承接 carryover seed）；代码默认 true，可回滚
# LLM_CONTEXT_FLOOR_MINUTES=15         # 最近「硬底」时间窗：此窗内原文永不被摘要/丢弃（硬底优先于 token 预算）；0=关该维度
# LLM_CONTEXT_FLOOR_TURNS=10           # 最近「硬底」轮数上限（与时间窗取交集）；0=关该维度；两维都 0=不设硬底
# ROLLING_SUMMARY_CHUNK_TOKENS=1500      # 尾窗超预算时后台一次压掉的最老 chunk 目标 token（按整条消息截断），压完留 headroom
# LLM_PROVIDERS_JSON=[{"id":"deepseek","family":"deepseek","tier":"flash","label":"DeepSeek V4 Flash","protocol":"openai_chat","base_url":"https://api.deepseek.com","api_key_env":"LLM_API_KEY","model":"deepseek-v4-flash","supports_tools":true},{"id":"deepseek-v4-pro","family":"deepseek","tier":"pro","label":"DeepSeek V4 Pro","protocol":"openai_chat","base_url":"https://api.deepseek.com","api_key_env":"LLM_API_KEY","model":"deepseek-v4-pro","supports_tools":true},{"id":"chatgpt","family":"openai","tier":"pro","label":"ChatGPT","protocol":"openai_responses","base_url":"https://co.yes.vg","api_key_env":"LLM_OPENAI_API_KEY","model":"gpt-5.5","supports_tools":true},{"id":"gpt-mini","family":"openai","tier":"flash","label":"GPT mini","protocol":"openai_responses","base_url":"https://co.yes.vg","api_key_env":"LLM_OPENAI_API_KEY","model":"gpt-5.5-mini","supports_tools":true},{"id":"claude","family":"anthropic","tier":"pro","label":"Claude","protocol":"anthropic_messages","base_url":"https://co.yes.vg","api_key_env":"LLM_ANTHROPIC_API_KEY","model":"claude-sonnet-4-6","supports_tools":true}]
# ALIYUN_WEB_SEARCH_ENABLED=true       # 代码默认 false
# WEB_SEARCH_DEFAULT_PROVIDER=aliyun   # 代码默认 duckduckgo
# WEB_SEARCH_PROVIDER_ORDER=aliyun,bing
# WEB_SEARCH_SYNC_TIMEOUT_SECONDS=3.0  # 单次供应商搜索请求超时（秒），代码默认 3.0
# IMAGE_UNDERSTANDING_ENABLED=false    # 代码默认 true（v1.5 起）；缺 DASHSCOPE_API_KEY 时自动落兜底文案
# IMAGE_UNDERSTANDING_MODEL=qwen3-vl-plus
# IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=30
# IMAGE_MAX_BYTES=10485760             # 单张图片读取上限，默认 10MB
# IMAGE_INBOUND_DIR=~/.openclaw/media/inbound   # 只读取该目录内的本地图片
# IMAGE_UNDERSTANDING_COST_SHELL_MICROS=5000000 # 单次图片理解固定扣 5 贝壳
# MODERATION_ENABLED=true              # 内容审核总开关；Phase A 只执行本地规则和任务记录
# MODERATION_SYNC_GUARD_ENABLED=true   # 出站同步红线拦截；命中 block/escalate 时不发送原文
# MODERATION_WORKER_ENABLED=false      # 生产推荐独立 worker；Phase A 保持 false
# MODERATION_WORKER_BATCH_SIZE=50
# MODERATION_WORKER_INTERVAL_SECONDS=5
# MODERATION_WORKER_CLAIM_TIMEOUT_SECONDS=300 # worker claim 超时后允许其他 worker 重试
# MODERATION_WORKER_MAX_ATTEMPTS=3     # 机器审核连续失败达到次数后进入人工队列
# MODERATION_SENSITIVE_TERMS_PATH=data/moderation/sensitive_terms.json # 本地敏感词/规则 JSON
# MODERATION_SHORT_TEXT_SKIP_CHARS=8   # 极短文本可跳过 LLM 抽检，但仍执行本地规则
# MODERATION_INBOUND_SAMPLE_PERCENT=15 # 入站 LLM 抽检比例；本地规则始终 100%
# MODERATION_OUTBOUND_SAMPLE_PERCENT=30 # 同步回复 LLM 抽检比例；本地规则始终 100%
# MODERATION_PROACTIVE_SAMPLE_PERCENT=100 # 主动消息 LLM 抽检比例
# MODERATION_LLM_ENABLED=false         # Phase B 前保持 false；开启后复用全局默认 LLM provider
# MODERATION_LLM_BASE_URL=             # legacy ignored；不再单独配置审核模型地址
# MODERATION_LLM_API_KEY=              # legacy ignored；不再单独配置审核模型 key
# MODERATION_LLM_MODEL=                # legacy ignored；不再单独配置审核模型
# MODERATION_LLM_TIMEOUT_SECONDS=20    # legacy ignored；使用全局 LLM timeout/provider 配置
# MODERATION_LLM_PROMPT_VERSION=moderation_llm_v1
# MODERATION_IMAGE_SAFETY_ENABLED=false # 图片机审总开关；开启还需下面三项齐备才真正生效
# 阿里云图片审核 2.0 的 service 场景码（留空 = 未配置，链路整体不入队、不报错）。
# 常用：baselineCheck（通用基线）/ baselineCheck_pro（专业版）/ profilePhotoCheck（头像）。
# MODERATION_IMAGE_SAFETY_MODEL=baselineCheck
# MODERATION_EXPORT_DIR=data/moderation_exports
# MODERATION_SAFE_FALLBACK_TEXT=这条内容我不能继续发送，我们换个安全的话题吧。
# MODERATION_BLOCKED_PLACEHOLDER=[blocked by moderation]
# ===== 第二阶段：入站用户内容阿里云云审核（同步）；复用上面的 ALIYUN_ACCESS_KEY_ID/SECRET =====
# MODERATION_ALIYUN_ENABLED=false        # 入站阿里云文本审核 PLUS 总开关；false 时回退本地规则异步审核
# MODERATION_ALIYUN_INBOUND_SYNC_ENABLED=true # 入站同步拦截开关；false 时仅异步记录不停回复
# MODERATION_ALIYUN_ENDPOINT=green-cip.cn-beijing.aliyuncs.com # 内容安全 endpoint（默认北京）
# MODERATION_ALIYUN_SERVICE=chat_detection_pro # 文本审核 PLUS service 场景码
# MODERATION_ALIYUN_TIMEOUT_MS=1000      # connect/read 超时（毫秒）；超时降级本地规则
# MODERATION_INBOUND_BLOCKED_REPLY_TEXT=这个话题我不太方便继续，我们换个轻松点的聊聊吧～ # 入站命中停回复时的固定安全话术
# MODERATION_ALIYUN_ALERT_ENABLED=true   # 阿里云审核失败率告警；复用 FEISHU_ALERT_WEBHOOK_URL，未配 webhook 时不发送
# MODERATION_ALIYUN_ALERT_WINDOW_SECONDS=300 # 失败率统计滑动窗口（秒）
# MODERATION_ALIYUN_ALERT_FAILURE_RATE=0.2 # 窗口内失败率超过该比例即告警（0~1）
# MODERATION_ALIYUN_ALERT_MIN_SAMPLES=5  # 失败率告警最小样本量，避免极少量调用误报
# MODERATION_ALIYUN_ALERT_CONSECUTIVE=3  # 连续失败次数达到该值即告警
# MODERATION_ALIYUN_ALERT_COOLDOWN_SECONDS=300 # 告警冷却时间（秒），避免抖动刷屏
# OPENCLAW_INBOUND_REQUIRE_BINDING=false # 代码默认 true；true 时未绑定/已解绑微信入站直接 no_reply 不建账号。本地用 send_mock_turn（account=local 无绑定）调试需置 false
# OPENCLAW_CLI_PATH=openclaw # 代码默认裸命令名(靠 PATH)；若 backend/scheduler 服务 PATH 不含 openclaw 所在目录，填绝对路径如 /home/<user>/.openclaw/bin/openclaw，否则主动消息/登录会 Errno 2
# OPENCLAW_GATEWAY_WS_ENABLED=false # true 时 send_weixin_text 优先复用本机 Gateway WS 长连接；默认 false 保持 CLI 行为
# OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789 # 留空则读取 ~/.openclaw/openclaw.json 的 gateway.port
# OPENCLAW_GATEWAY_WS_TOKEN= # 可显式配置；留空且 READ_OPENCLAW_CONFIG=true 时读取 OpenClaw gateway.auth.token
# OPENCLAW_GATEWAY_WS_PASSWORD= # password auth 模式；留空且 READ_OPENCLAW_CONFIG=true 时读取 OpenClaw gateway.auth.password
# OPENCLAW_GATEWAY_WS_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_GATEWAY_WS_READ_OPENCLAW_CONFIG=true
# OPENCLAW_GATEWAY_WS_FALLBACK_TO_CLI=true # WS 失败时回落 openclaw gateway call send，便于灰度回滚
# OPENCLAW_GATEWAY_WS_CONNECT_TIMEOUT_MS=3000
# OPENCLAW_GATEWAY_WS_REQUEST_TIMEOUT_MS=5000
# OPENCLAW_GATEWAY_WS_PROTOCOL_VERSION=4
# OPENCLAW_GATEWAY_WS_WARMUP_ON_STARTUP=false
# PROACTIVE_SEND_RATE_LIMIT_MAX_RETRIES=2   # 主动消息被限速(ret=-2)时的退避重试次数，代码默认 2；设 0 则限速即落 failed
# PROACTIVE_SEND_RATE_LIMIT_BACKOFF_SECONDS=3 # 限速退避基数秒，代码默认 3；线性退避(3s/6s/...)，仅作用于后台主动消息
# RATE_LIMIT_DAILY=5000                # 代码默认 5000；每账号每日消息上限，0 表示不启用
# RATE_LIMIT_RPM=10                    # 代码默认 10；设 0 表示不启用短窗口限流
# RATE_LIMIT_RPM_WINDOW_SECONDS=30     # 代码默认 30，含义为 30 秒内最多 RATE_LIMIT_RPM 条
# PROACTIVE_CONTENT_INVITATION_TOOL_ROUNDS=5  # 内容邀请生成允许的工具轮次，可多轮搜索后创建候选
# REACTIVATION_DISPATCH_ENABLED=false  # 拉活发送 kill-switch；默认 false，开启前必须显式置 true
# REACTIVATION_DISPATCH_DRY_RUN=true   # 即使 enabled=true，默认仍 dry-run；生产灰度通过时改 false 才会真发
# NEW_USER_REACTIVATION_DAILY_LIMIT=4  # 新用户注册/绑定后 24h 内破冰唤回日上限；实际还受 6h 冷却约束
# NEW_USER_REACTIVATION_WINDOW_HOURS=24 # 新用户破冰唤回窗口，按账号创建时间起算
# NEW_USER_REACTIVATION_IDLE_HOURS=2   # 用户最近入站后至少沉默多久才规划破冰唤回
# NEW_USER_REACTIVATION_COOLDOWN_HOURS=6 # 新用户破冰唤回两次触发之间的最小间隔
# CONTENT_INVITATION_DAILY_LIMIT=1     # 内容邀请日上限（含原拉活内容唤回，已并入本分类）。原名 REACTIVATION_DAILY_LIMIT
# PROACTIVE_PLANNING_INTERVAL_SECONDS=3600  # 每个账号两次 planning pass 之间的最小间隔，单位秒
# REACTIVATION_SEND_SLOTS=12:15,18:15,21:05
# REACTIVATION_AVOIDANCE_WINDOW_MINUTES=60
# REACTIVATION_DEDUPE_DAYS=3
# REACTIVATION_SEND_JITTER_MIN_SECONDS=60   # 拉活发送在 slot 时间上叠加的前向随机抖动下界，代码默认 60
# REACTIVATION_SEND_JITTER_MAX_SECONDS=300  # 抖动上界，代码默认 300(=5分钟)；无强时效性，拉大以摊平单 IP 发送、降风控信号。0 关闭抖动
# PROACTIVE_FREQUENCY_MAX_PER_DAY_CAP=3   # 用户自定义每日主动消息上限的系统硬顶，用户值超过即封顶到此
# PROACTIVE_FREQUENCY_MAX_PER_WEEK_CAP=14 # 用户自定义每周主动消息上限的系统硬顶
# --- 近期热点（hot_topic）全局召回：搜索近24h热点→抽主题成无主池→每账号LLM打分选择→top1拉活。默认关 ---
# HOT_TOPIC_RECALL_ENABLED=false          # 全局召回总开关（fail-closed）；需 LLM 就绪才生效（web_search 已常开，见 app/config.py::WEB_SEARCH_ENABLED）
# HOT_TOPIC_POOL_REFRESH_INTERVAL_SECONDS=3600  # 调度器内全局热点池刷新最小间隔（秒）；进程重启归零→首 tick 立即刷一次
# HOT_TOPIC_SOURCES=toutiao,zhihu            # 热榜数据来源（逗号分隔）；非空时优先热榜，全部失败才降级 web search
# HOT_TOPIC_TOUTIAO_URL=https://60s.viki.moe/v2/toutiao
# HOT_TOPIC_ZHIHU_URL=https://60s.viki.moe/v2/zhihu
# HOT_TOPIC_ZHIHU_BACKUP_URL=               # 知乎备用 URL；空=不启用
# HOT_TOPIC_FETCH_TIMEOUT_SECONDS=5.0       # 每个热榜来源 HTTP 超时（秒）
# HOT_TOPIC_MAX_ITEMS_PER_SOURCE=20         # 每个来源最多取条目数
# HOT_TOPIC_RECALL_QUERY=过去24小时国内外热点新闻话题  # 全局召回搜索 query
# HOT_TOPIC_POOL_SIZE=8                    # 单日全局池最多抽取的主题数
# HOT_TOPIC_SELECT_TOP_K=3                 # 每账号相关性排序后保留、参与多样性打散的候选数
# HOT_TOPIC_HISTORY_DEDUPE_DAYS=3          # 全局历史去重回看天数（近 N 天已入池主题不再入池）
# HOT_TOPIC_TTL_HOURS=24                   # 全局候选池条目存活时长（小时）
# HOT_TOPIC_MIN_SCORE=0.3                  # 每账号 LLM 相关性分数下限，低于则不选
# HOT_TOPIC_PROFILE_CONTEXT_MESSAGES=50    # 打分时喂入的近期聊天条数（近 30 天内）
# HOT_TOPIC_DISPATCH_DRY_RUN=true          # hot_topic 发送独立 dry_run（fail-closed）；true 时只记录 would_send 不真发；两个 dry_run 均 false 才真实发热点

# ===== TDAI 长期记忆 sidecar（docs/tech_design/tdai_multitenant_design.md）=====
# TDAI_ENABLED=false                          # 总开关；生产启用时改 true，同时确保 TDAI Gateway 已就绪
# TDAI_GATEWAY_URL=http://127.0.0.1:8420      # TDAI Gateway 地址，仅绑 loopback
# TDAI_GATEWAY_API_KEY=                       # Gateway Bearer token；非空时才生效
# TDAI_RECALL_ENABLED=true                    # recall 子开关；master 关则整体关
# TDAI_CAPTURE_ENABLED=true                   # capture 子开关；master 关则整体关
# TDAI_RECALL_TIMEOUT_SECONDS=0.5             # 热路径严格超时（秒），超时直接降级不阻主回复；0.5 覆盖 DashScope embedding warm 长尾
# TDAI_CAPTURE_TIMEOUT_SECONDS=2.0            # after-turn capture 超时（秒，后台 best-effort）
# TDAI_RECALL_MAX_CHARS=2500                  # 每段 recall 注入内容最大字符数
# TDAI_RECALL_ACCOUNT_ALLOWLIST=              # 逗号分隔 account_id；空=recall 对所有账号关闭（capture 全量不受此控制）
# --- 主动检索工具（tdai_memory_search / tdai_conversation_search）---
# TDAI_SEARCH_ENABLED=false                   # 两个 search 工具总开关；独立于 recall，可单独灰度。启用时启动会做 multiTenant 探针
# TDAI_SEARCH_TIMEOUT_SECONDS=2.0             # 模型 tool loop 内调用超时（秒），非开口热路径可比 recall 宽松
# TDAI_SEARCH_MAX_CALLS_PER_TURN=3            # 每轮两个 search 工具合计上限（TDAI 后端未实现，由本侧计数强制）
# TDAI_SEARCH_ACCOUNT_ALLOWLIST=              # 逗号分隔 account_id；空=search 对所有账号关闭（独立于 recall allowlist）
# TDAI_MEMORY_MIN_MESSAGES=50                 # recall+search 自然灰度阈值：账号累计 inbound(用户)消息数≥此值即对记忆功能开放（与各自 allowlist 取并集）；0=只认 allowlist

# ===== 动态提醒 / 例行简报（docs/tech_design/dynamic_reminder_scheduled_content_design.md）=====
# 两机都要配：aliyun2 处理入站创建 dynamic 提醒需 enabled+allowlist；aliyun1 统一调度执行到期履约+出站分发。
# DYNAMIC_REMINDER_ENABLED=false                       # 单一总开关：开=对所有账号放开 dynamic 履约/创建(全量)，关=整体禁用
# DYNAMIC_REMINDER_MAX_ACTIVE_PER_ACCOUNT=5            # 每账号活跃(pending) dynamic 提醒上限
# DYNAMIC_REMINDER_BATCH_SIZE=5                        # 单次调度扫描处理的 dynamic 到期批量上限
# DYNAMIC_REMINDER_MAX_RETRIES=2                       # 履约失败(搜索/生成)的重试次数
# DYNAMIC_REMINDER_FULFILLMENT_TOOLS=web_search        # 履约合成轮次可用工具集(逗号分隔)；v1 只 web_search，后续放开只改此项
# DYNAMIC_REMINDER_FORCE_FIRST_TOOL=                   # 首轮工具选择约束(逗号分隔)；默认空=auto。thinking 模型(deepseek-v4-pro)只接受 auto，强制搜索靠提示词+search_ok 校验；换非 thinking provider 才设 web_search

# ===== 数据备份（scripts/backup_data.py，systemd ai4all-backup.timer 每日触发）=====
# BACKUP_DIR=data/backups              # 代码默认 data/backups
# BACKUP_RETENTION_COUNT=14            # 代码默认 14，保留最新份数，更旧的自动删除
# BACKUP_RSYNC_TARGET=user@host:/srv/ai4all-backups  # 异地 rsync 目标；空=只存本机。失败时走 FEISHU_ALERT_WEBHOOK_URL 报警
# App V1 batch ASR。默认保留 OpenAI-compatible；朝夕生产推荐 volcengine_flash。
# /app/config.features.voice_input 会按所选 provider 的完整凭据判断，凭据不完整时客户端隐藏入口。
ASR_PROVIDER=openai_compatible
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_TIMEOUT_SECONDS=30
# 豆包大模型录音文件识别极速版。两种鉴权任选其一：
# 1) 新版 API Key：只填 VOLCENGINE_ASR_API_KEY；
# 2) 旧版 App ID + Access Token：两项都填，便于从旧项目平滑迁移。
VOLCENGINE_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_API_KEY=
# M4A/AAC 只为 ASR 临时转成 16kHz 单声道 WAV；原始媒体仍原样存储和播放。
# 留空使用 requirements.txt 固定的内置二进制；也可填系统 ffmpeg 绝对路径覆盖。
ASR_FFMPEG_PATH=
ASR_TRANSCODE_TIMEOUT_SECONDS=15
ASR_MAX_AUDIO_BYTES=10485760
ASR_MAX_DURATION_MS=60000
# Local/test only. Production ignores mock transcripts.
ASR_MOCK_TRANSCRIPT=

# ===== 用户自建角色模板与邀请链接（默认关闭）=====
# 开启前需完成 migration 59、创建者/Admin API、Web 参数续传和双后端回归。
# 关闭时禁止创建、编辑、审核、发布、恢复和新的 urt_ 实例化；已归因账号继续使用自己的快照。
CREATOR_ROLE_TEMPLATES_ENABLED=false

# ===== 鸣蝉 Companion World（默认关闭）=====
# 新部署只配置 MINGCHAN_*。旧 COMPANION_WORLD_* 仅保留一个发布周期的只读兼容，
# 若两者同时存在，以 MINGCHAN_* 为准。
# 开启前必须：1) 四模板导入与预检通过；2) 存量 backfill dry-run/实跑通过；
# 3) 客户端最低版本已支持 auth 响应 account=null 并立即调用 world bootstrap。
# 本开关只控制 API/auth。后台 L3 与 proactive safety 可由下面两个独立开关控制。
MINGCHAN_P1_ENABLED=false
# false 时停止 World L3 prompt 读取、typed sink 写入与 compact；不删除既有 facts。
MINGCHAN_L3_BACKGROUND_ENABLED=true
# false 时关闭 world-aware 真人级 proactive safety gate，恢复旧 per-account 判定。
MINGCHAN_PROACTIVE_SAFETY_ENABLED=true
# 自建角色受控头像的公网前缀（不含尾部斜杠也可）。留空则下发相对路径，本地/测试用；
# 生产填站点根域，例如 https://example.com，客户端据此直接拼出可访问的 avatar_ref。
MINGCHAN_ASSET_BASE_URL=

# ===== 鸣蝉 M3 Feed（默认关闭）=====
# 控制文字 Feed API、AI world-content scheduler 与 Feed outbox consumer；
# 不控制 P1 API/L3/proactive/App 通知。回滚时关闭本项并停止独立 scheduler。
# 仅在 MINGCHAN_P1_ENABLED=true 且客户端已支持 Feed 契约后灰度开启。
MINGCHAN_FEED_ENABLED=false
# 北京本地半开区间 [start,end)；启用独立 world-content scheduler 前四项必须填写，禁止重叠/跨日。
# 生产值由部署评审提供，仓库不预设发送时刻。
MINGCHAN_FEED_MORNING_START=
MINGCHAN_FEED_MORNING_END=
MINGCHAN_FEED_EVENING_START=
MINGCHAN_FEED_EVENING_END=
# world-content 独立中心进程参数；不挂到厚节点 proactive scheduler。
MINGCHAN_FEED_SCHEDULER_INTERVAL_SECONDS=60
MINGCHAN_FEED_SCHEDULER_BATCH_SIZE=20
MINGCHAN_FEED_CLAIM_LEASE_SECONDS=300
MINGCHAN_FEED_RETRY_MAX_ATTEMPTS=3
MINGCHAN_FEED_RETRY_BASE_SECONDS=30
MINGCHAN_OUTBOX_BATCH_SIZE=50
MINGCHAN_OUTBOX_CLAIM_LEASE_SECONDS=300
MINGCHAN_OUTBOX_MAX_ATTEMPTS=5

# ===== 鸣蝉 M3 App 拉取式通知收件箱（默认关闭）=====
# 控制通知 API 与 AppInboxAdapter visible 写入；不控制微信 outbound，也不改变平台渠道 gateway
# 的 supports_proactive=false。鸣蝉通知是产品内 pull inbox 资产，不经过渠道主动推送能力。
MINGCHAN_APP_INBOX_ENABLED=false
# 真人级 App-only 主动触达独立闸；有效值为 APP_INBOX && 本项；
# 不控制 per-resident reminder/commitment、通知读取或微信 legacy 路径。
MINGCHAN_APP_ONLY_HUMAN_PROACTIVE_ENABLED=false
# central proactive scheduler 每轮 reservation/TTL/200 条对账批量；cleanup 不受 inbox flag 关闭影响。
MINGCHAN_NOTIFICATION_CLEANUP_BATCH_SIZE=100

# ===== 鸣蝉 M4 Lifecycle + Mailbox（默认关闭）=====
# evaluation 只允许 central scheduler 生成/推进内部候选；不执行不可逆 offline。
MINGCHAN_LIFECYCLE_EVALUATION_ENABLED=false
# 不可逆提交独立闸；关闭时 full admin approve 也必须 fail-closed。
MINGCHAN_LIFECYCLE_COMMIT_ENABLED=false
# 控制 mailbox owner API、投递、过期与接受；不撤销已接受 resident。
MINGCHAN_MAILBOX_ENABLED=false
# 冻结策略默认值；修改只影响新 event/letter，历史行保留 policy snapshot。
MINGCHAN_LIFECYCLE_INACTIVITY_DAYS=60
MINGCHAN_LIFECYCLE_EVIDENCE_WINDOW_DAYS=30
MINGCHAN_LIFECYCLE_MISMATCH_MIN_EVENTS=3
MINGCHAN_LIFECYCLE_MISMATCH_MIN_SPAN_DAYS=14
MINGCHAN_LIFECYCLE_COOLDOWN_DAYS=7
MINGCHAN_LIFECYCLE_CRISIS_FREEZE_DAYS=30
MINGCHAN_MAILBOX_DELIVERY_COOLDOWN_DAYS=30
MINGCHAN_MAILBOX_LETTER_TTL_DAYS=30
# mailbox catalog 签名 manifest 的 HMAC-SHA256 密钥；生产放 secret manager，不提交仓库。
MINGCHAN_MAILBOX_MANIFEST_HMAC_SECRET=
# 后续 M4-2 使用的 central-only 独立 scheduler；M4-1 尚不接 live composition。
MINGCHAN_LIFECYCLE_SCHEDULER_INTERVAL_SECONDS=300
MINGCHAN_LIFECYCLE_SCHEDULER_BATCH_SIZE=50

# M5 限时来访总闸；默认关闭。开启前必须完成 m0035、客户端 pending/ACL 与双后端并发门禁。
MINGCHAN_VISITS_ENABLED=false
# M5 真人文字聊天写闸；依赖 VISITS_ENABLED。关闭时历史读取/举报/拉黑仍须可用。
MINGCHAN_HUMAN_CHAT_ENABLED=false

# v1.5 媒体与异步许愿能力位；均依赖 MINGCHAN_P1_ENABLED。
# 三个媒体位默认 true；异步许愿不设独立开关，随 MAILBOX_ENABLED 可用。
# 媒体三位是否真的对客户端可见还取决于 MEDIA_URL_SIGNING_SECRET 是否配置（见下）。
MINGCHAN_CHAT_IMAGE_ENABLED=true
MINGCHAN_CHAT_VOICE_ENABLED=true
MINGCHAN_FEED_IMAGE_ENABLED=true
# 异步许愿受理后 24–72h 投递信箱；旧 preview 不再接受 wish_text。
# 每人滚动 24 小时受理上限（重放不计次，<=0 不限制）；经 /app/config 的 limits 下发。
MINGCHAN_WISH_DAILY_MAX=10
# worker claim lease 与失败重试间隔；任务状态持久化在 resident_wish_jobs。
MINGCHAN_WISH_JOB_LEASE_SECONDS=600
MINGCHAN_WISH_RETRY_SECONDS=3600

# --- v1.5 媒体地基（三个媒体开关共用）---
# 落盘根目录；库里只存相对路径，换对象存储不用改数据。
MEDIA_STORAGE_DIR=data/media
# 读 URL 的 HMAC 签名密钥，**媒体能力的实际开关在这里**：留空 = 媒体三位一律下发 false、
# 上传返回 media_disabled（启动只告警不中断）；配上并重启后媒体能力才对客户端可见。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
MEDIA_URL_SIGNING_SECRET=
# 签名有效期；访客实际取 min(本值, visit 剩余时长)，visit 结束即失效。
MEDIA_URL_OWNER_TTL_SECONDS=900
MEDIA_URL_VISITOR_TTL_SECONDS=600
# 未被引用的上传保留时长与回收扫描间隔。
MEDIA_PENDING_TTL_HOURS=2
MEDIA_RECLAIM_INTERVAL_SECONDS=3600
# 媒体消息限额。注意与 ASR_MAX_* 是两个口径：后者是语音输入转写上限（10MB/60s）。
MEDIA_IMAGE_MAX_BYTES=8388608
MEDIA_IMAGE_COUNT_MAX=4
MEDIA_VOICE_MAX_BYTES=512000
MEDIA_VOICE_MAX_DURATION_MS=60000
# --- v1.5 图片机审（S4）；开通步骤见 docs/ops/platform/image_moderation_setup.md ---
# 媒体读端点的公网 origin（不含 /api/v1/media），例如 https://ai4company.top。
# 配置后上传、消息列表、Feed 都返回完整 HTTPS URL，移动端可直接加载；同时供阿里云回源取图。
# 留空仅适合本地开发（返回相对路径），且图片机审不可用。
MEDIA_PUBLIC_BASE_URL=
MEDIA_MODERATION_INTERVAL_SECONDS=60
MEDIA_MODERATION_BATCH_SIZE=50
# 语音转写失败时写进 LLM 上下文的兜底话术。
VOICE_MESSAGE_FALLBACK_TEXT=这段语音我没听清，你可以打字告诉我，或者再发一次～
