AI4ALL_BRIDGE_SECRET=dev-secret
ADMIN_TOKEN=dev-admin-token
APP_ENV=local
DATABASE_PATH=data/ai4all.sqlite3

# OpenAI-compatible chat completions API. Leave LLM_API_KEY empty to keep mock fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_CONTEXT_MESSAGES=12

RATE_LIMIT_DAILY=100
RATE_LIMIT_RPM=5
RATE_LIMIT_DAILY_MESSAGE=今天聊得有点多了，我晚些时候再继续陪你。
RATE_LIMIT_RPM_MESSAGE=消息来得太快了，稍等一下再发我吧。
