# AI4ALL Weixin Bot — 环境配置模板
# 复制为 .env 并填写真实值，不要提交 .env。
# 未列出的参数均已在 app/config.py 中设有生产安全的默认值，只在需要偏离时添加。

# ===== 必须设置（密钥 / 凭据）=====
AI4ALL_BRIDGE_SECRET=dev-secret         # 生产必须改为随机长字符串
ADMIN_TOKEN=dev-admin-token             # 生产必须改为随机长字符串
ADMIN_STAFF_TOKEN=
ADMIN_REVIEWER_TOKEN=                  # 人工审核员 token；只能访问 moderation 队列和详情
LLM_API_KEY=                            # 留空则使用 mock 回退（仅 local/test）
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_WEBSITE_WEBHOOK_URL=
FEISHU_ERROR_LOG_ALERT_ENABLED=true      # true 时 ai4all.* ERROR/exception 日志会推送 FEISHU_ALERT_WEBHOOK_URL
FEISHU_ERROR_LOG_ALERT_MIN_INTERVAL_SECONDS=300  # 同类错误日志飞书报警冷却时间，避免刷屏
FEISHU_ERROR_LOG_ALERT_TIMEOUT_SECONDS=3.0       # 推送飞书 webhook 的请求超时（秒），最小 0.5
FEISHU_ERROR_LOG_ALERT_MAX_CHARS=3500            # 单条报警最大字符数，超出截断，最小 500

# ===== 部署拓扑（每个环境必须明确设置）=====
APP_ENV=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PROACTIVE_SCHEDULER_ENABLED=false       # 生产推荐独立进程，保持 false
DREAMING_SCHEDULER_ENABLED=false

# ===== 多机接入（central 大脑 + 瘦 node；见 docs/tech_design/multi_node_access_refactor.md）=====
# 默认 standalone = 今天单机形态，下面除 AI4ALL_ROLE 外都可留空，行为不变。
AI4ALL_ROLE=standalone                  # standalone(默认) | central | node | "central,node"(aliyun1 同机共存)
NODE_ID=                                # 含 node 能力时必填，全局唯一(如 aliyun1 / aliyun2)
DEFAULT_NODE_ID=                        # 账号未分配节点时的兜底归属(迁移期=aliyun1)；standalone 留空
CENTRAL_URL=                            # node→中心 的稳定指纹地址(MVP=http://aliyun1)，不要写裸 IP
NODE_BASE_URL=                          # 本节点基址(中心 push 登录用)，写入 access_nodes(如 http://aliyun2:8190)
NODE_AGENT_HOST=0.0.0.0                 # node agent HTTP 监听地址
NODE_AGENT_PORT=8190                    # node agent HTTP 端口
NODE_MAX_SESSIONS=0                     # 本机会话上限(MVP 仅上报，0=未设)
OUTBOUND_PULL_INTERVAL_SECONDS=2        # 节点出站轮询间隔(秒)
OUTBOUND_PULL_BATCH_SIZE=20             # 节点单轮认领条数
OUTBOUND_CLAIM_TIMEOUT_SECONDS=60       # sending 卡死回收阈值(节点崩溃安全网)
LOCAL_NODE_INLINE_DISPATCH=false        # true: central 同机 node 出站走同进程即时发(迁移期降延迟)

# ===== 第三方服务凭据（按需填写）=====
DASHSCOPE_API_KEY=
ALIYUN_WEB_SEARCH_API_KEY=
BAIDU_AI_SEARCH_API_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_PREFIX=

# ===== 调试（生产保持默认关闭）=====
# ADMIN_DEBUG_PLAINTEXT_ENABLED=true
# ADMIN_DEBUG_PLAINTEXT_ACCOUNT_ALLOWLIST=aid_123456789,aid_987654321
# DEBUG_TRACE_ACCOUNT_IDS=aid_123456789

# ===== 可选覆盖（有合理代码默认值，只在需要偏离时取消注释）=====
# LLM_TIMEOUT_SECONDS=20               # 代码默认 40，本地加速用
# LLM_CONTEXT_MESSAGES=12              # 代码默认 100，本地省 token 用
# ALIYUN_WEB_SEARCH_ENABLED=true       # 代码默认 false
# BAIDU_AI_SEARCH_ENABLED=true         # 代码默认 false
# WEB_SEARCH_ENABLED=true              # 代码默认 false
# WEB_SEARCH_DEFAULT_PROVIDER=baidu    # 代码默认 duckduckgo
# WEB_SEARCH_PROVIDER_ORDER=baidu,duckduckgo,bing
# IMAGE_UNDERSTANDING_ENABLED=true     # 代码默认 false；开启微信图片理解（需 DASHSCOPE_API_KEY）
# IMAGE_UNDERSTANDING_MODEL=qwen3-vl-plus
# IMAGE_UNDERSTANDING_TIMEOUT_SECONDS=30
# IMAGE_MAX_BYTES=10485760             # 单张图片读取上限，默认 10MB
# IMAGE_INBOUND_DIR=~/.openclaw/media/inbound   # 只读取该目录内的本地图片
# IMAGE_UNDERSTANDING_COST_SHELL_MICROS=5000000 # 单次图片理解固定扣 5 贝壳
# MODERATION_ENABLED=true              # 内容审核总开关；Phase A 只执行本地规则和任务记录
# MODERATION_SYNC_GUARD_ENABLED=true   # 出站同步红线拦截；命中 block/escalate 时不发送原文
# MODERATION_WORKER_ENABLED=false      # 生产推荐独立 worker；Phase A 保持 false
# MODERATION_WORKER_BATCH_SIZE=50
# MODERATION_WORKER_INTERVAL_SECONDS=5
# MODERATION_WORKER_CLAIM_TIMEOUT_SECONDS=300 # worker claim 超时后允许其他 worker 重试
# MODERATION_WORKER_MAX_ATTEMPTS=3     # 机器审核连续失败达到次数后进入人工队列
# MODERATION_SENSITIVE_TERMS_PATH=data/moderation/sensitive_terms.json # 本地敏感词/规则 JSON
# MODERATION_SHORT_TEXT_SKIP_CHARS=8   # 极短文本可跳过 LLM 抽检，但仍执行本地规则
# MODERATION_INBOUND_SAMPLE_PERCENT=15 # 入站 LLM 抽检比例；本地规则始终 100%
# MODERATION_OUTBOUND_SAMPLE_PERCENT=30 # 同步回复 LLM 抽检比例；本地规则始终 100%
# MODERATION_PROACTIVE_SAMPLE_PERCENT=100 # 主动消息 LLM 抽检比例
# MODERATION_LLM_ENABLED=false         # Phase B 前保持 false，不调用外部审核模型
# MODERATION_LLM_BASE_URL=
# MODERATION_LLM_API_KEY=
# MODERATION_LLM_MODEL=
# MODERATION_LLM_TIMEOUT_SECONDS=20
# MODERATION_LLM_PROMPT_VERSION=moderation_llm_v1
# MODERATION_IMAGE_SAFETY_ENABLED=false # Phase B 前保持 false
# MODERATION_IMAGE_SAFETY_MODEL=
# MODERATION_EXPORT_DIR=data/moderation_exports
# MODERATION_SAFE_FALLBACK_TEXT=这条内容我不能继续发送，我们换个安全的话题吧。
# MODERATION_BLOCKED_PLACEHOLDER=[blocked by moderation]
# ===== 第二阶段：入站用户内容阿里云云审核（同步）；复用上面的 ALIYUN_ACCESS_KEY_ID/SECRET =====
# MODERATION_ALIYUN_ENABLED=false        # 入站阿里云文本审核 PLUS 总开关；false 时回退本地规则异步审核
# MODERATION_ALIYUN_INBOUND_SYNC_ENABLED=true # 入站同步拦截开关；false 时仅异步记录不停回复
# MODERATION_ALIYUN_ENDPOINT=green-cip.cn-beijing.aliyuncs.com # 内容安全 endpoint（默认北京）
# MODERATION_ALIYUN_SERVICE=chat_detection_pro # 文本审核 PLUS service 场景码
# MODERATION_ALIYUN_TIMEOUT_MS=1000      # connect/read 超时（毫秒）；超时降级本地规则
# MODERATION_INBOUND_BLOCKED_REPLY_TEXT=这个话题我不太方便继续，我们换个轻松点的聊聊吧～ # 入站命中停回复时的固定安全话术
# MODERATION_ALIYUN_ALERT_ENABLED=true   # 阿里云审核失败率告警；复用 FEISHU_ALERT_WEBHOOK_URL，未配 webhook 时不发送
# MODERATION_ALIYUN_ALERT_WINDOW_SECONDS=300 # 失败率统计滑动窗口（秒）
# MODERATION_ALIYUN_ALERT_FAILURE_RATE=0.2 # 窗口内失败率超过该比例即告警（0~1）
# MODERATION_ALIYUN_ALERT_MIN_SAMPLES=5  # 失败率告警最小样本量，避免极少量调用误报
# MODERATION_ALIYUN_ALERT_CONSECUTIVE=3  # 连续失败次数达到该值即告警
# MODERATION_ALIYUN_ALERT_COOLDOWN_SECONDS=300 # 告警冷却时间（秒），避免抖动刷屏
# OPENCLAW_INBOUND_REQUIRE_BINDING=false # 代码默认 true；true 时未绑定/已解绑微信入站直接 no_reply 不建账号。本地用 send_mock_turn（account=local 无绑定）调试需置 false
# OPENCLAW_CLI_PATH=openclaw # 代码默认裸命令名(靠 PATH)；若 backend/scheduler 服务 PATH 不含 openclaw 所在目录，填绝对路径如 /home/<user>/.openclaw/bin/openclaw，否则主动消息/登录会 Errno 2
# PROACTIVE_SEND_RATE_LIMIT_MAX_RETRIES=2   # 主动消息被限速(ret=-2)时的退避重试次数，代码默认 2；设 0 则限速即落 failed
# PROACTIVE_SEND_RATE_LIMIT_BACKOFF_SECONDS=3 # 限速退避基数秒，代码默认 3；线性退避(3s/6s/...)，仅作用于后台主动消息
# RATE_LIMIT_DAILY=5000                # 代码默认 5000；每账号每日消息上限，0 表示不启用
# RATE_LIMIT_RPM=10                    # 代码默认 10；设 0 表示不启用短窗口限流
# RATE_LIMIT_RPM_WINDOW_SECONDS=30     # 代码默认 30，含义为 30 秒内最多 RATE_LIMIT_RPM 条
# PROACTIVE_CONTENT_INVITATION_TOOL_ROUNDS=5  # 内容邀请生成允许的工具轮次，可多轮搜索后创建候选
# REACTIVATION_DISPATCH_ENABLED=false  # 拉活发送 kill-switch；默认 false，开启前必须显式置 true
# REACTIVATION_DISPATCH_DRY_RUN=true   # 即使 enabled=true，默认仍 dry-run；生产灰度通过时改 false 才会真发
# REACTIVATION_DAILY_LIMIT=1           # topic_followup + content_invitation 合并拉活日上限
# PROACTIVE_PLANNING_INTERVAL_SECONDS=3600  # 每个账号两次 planning pass 之间的最小间隔，单位秒
# REACTIVATION_SEND_SLOTS=12:15,18:15,21:05
# REACTIVATION_AVOIDANCE_WINDOW_MINUTES=60
# REACTIVATION_DEDUPE_DAYS=3
# REACTIVATION_SEND_JITTER_MIN_SECONDS=60   # 拉活发送在 slot 时间上叠加的前向随机抖动下界，代码默认 60
# REACTIVATION_SEND_JITTER_MAX_SECONDS=300  # 抖动上界，代码默认 300(=5分钟)；无强时效性，拉大以摊平单 IP 发送、降风控信号。0 关闭抖动
# PROACTIVE_FREQUENCY_MAX_PER_DAY_CAP=3   # 用户自定义每日主动消息上限的系统硬顶，用户值超过即封顶到此
# PROACTIVE_FREQUENCY_MAX_PER_WEEK_CAP=14 # 用户自定义每周主动消息上限的系统硬顶

# ===== 数据备份（scripts/backup_data.py，systemd ai4all-backup.timer 每日触发）=====
# BACKUP_DIR=data/backups              # 代码默认 data/backups
# BACKUP_RETENTION_COUNT=14            # 代码默认 14，保留最新份数，更旧的自动删除
# BACKUP_RSYNC_TARGET=user@host:/srv/ai4all-backups  # 异地 rsync 目标；空=只存本机。失败时走 FEISHU_ALERT_WEBHOOK_URL 报警
