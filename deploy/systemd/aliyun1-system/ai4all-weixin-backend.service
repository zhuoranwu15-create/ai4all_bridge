[Unit]
Description=AI4ALL Weixin Bot Backend (aliyun1, system)
After=network-online.target postgresql.service
Wants=network-online.target
# 原 user 单元含 After=openclaw-gateway.service；openclaw-gateway 为 user 级服务，
# system 级无法排序引用，backend 经 localhost 调用 + Restart 容错，运行期不受影响。

[Service]
Type=simple
User=jack
Group=devops
WorkingDirectory=/opt/workspace/ai4all_bridge
EnvironmentFile=/opt/workspace/ai4all_bridge/.env
Environment=HOME=/home/jack
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/bin:/home/jack/.local/bin:/home/jack/.npm-global/bin:/home/jack/bin
ExecStart=/opt/workspace/ai4all_bridge/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8180
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai4all-weixin-backend

[Install]
WantedBy=multi-user.target
