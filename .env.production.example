# AI4ALL Weixin Bot production environment template.
# Copy to .env on the Aliyun server and fill all required secrets there.
# Do not commit the real .env file.

APP_ENV=production
DATABASE_PATH=data/ai4all.sqlite3
USER_PROFILES_DIR=data/user_profiles
SYSTEM_DIR=data/system

# Required shared secret used by openclaw-bridge -> /openclaw/turn.
AI4ALL_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Required admin token. Keep /admin and /debug behind nginx IP allowlists too.
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
ADMIN_STAFF_TOKEN=
ADMIN_DEBUG_PLAINTEXT_ENABLED=false
ADMIN_DEBUG_PLAINTEXT_ACCOUNT_ALLOWLIST=

# OpenAI-compatible chat completions API. Production should not rely on mock fallback.
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=40
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1
LLM_MAX_TOOL_ROUNDS=3
LLM_FORCE_IPV4=true
LLM_CONTEXT_MESSAGES=12

# Request limits.
RATE_LIMIT_DAILY=100
RATE_LIMIT_RPM=5
RATE_LIMIT_DAILY_MESSAGE=今天聊得有点多了，我晚些时候再继续陪你。
RATE_LIMIT_RPM_MESSAGE=消息来得太快了，稍等一下再发我吧。

# Debug trace should stay empty in production unless diagnosing a specific account.
DEBUG_TRACE_ACCOUNT_IDS=

# Main conversation session lifecycle.
CONVERSATION_SESSION_MAX_TURNS=500
CONVERSATION_SESSION_BUSINESS_DAY_START_HOUR=4

# Dreaming memory scheduler. Keep disabled in FastAPI when using a separate worker.
DREAMING_SCHEDULER_ENABLED=false
DREAMING_SCHEDULER_INTERVAL_SECONDS=300
DREAMING_SCHEDULER_BATCH_SIZE=100

# Web onboarding -> OpenClaw QR login.
OPENCLAW_LOGIN_AUTO_START=true
OPENCLAW_LOGIN_START_TIMEOUT_MS=35000
OPENCLAW_LOGIN_WAIT_TIMEOUT_MS=480000
OPENCLAW_GATEWAY_CALL_TIMEOUT_MS=60000

# Proactive outbound and scheduler.
# Recommended production shape: FastAPI keeps PROACTIVE_SCHEDULER_ENABLED=false;
# run scripts/run_proactive_scheduler.py as a separate systemd service.
PROACTIVE_OUTBOUND_ENABLED=true
PROACTIVE_OUTBOUND_DAILY_LIMIT=3
PROACTIVE_QUIET_HOURS_START=22:00
PROACTIVE_QUIET_HOURS_END=08:00
COMPANION_FOLLOWUP_DAILY_LIMIT=1
CONTENT_INVITATION_DAILY_LIMIT=1
PROACTIVE_AVOIDANCE_WINDOW_HOURS=6
CONTENT_INVITATION_REJECTION_COOLDOWN_DAYS=30
CONTENT_INVITATION_EXPIRE_HOURS=24
PROACTIVE_SCHEDULER_ENABLED=false
PROACTIVE_SCHEDULER_INTERVAL_SECONDS=30
PROACTIVE_SCHEDULER_BATCH_SIZE=20
PROACTIVE_SCHEDULER_BYPASS_QUIET_HOURS=false
PROACTIVE_ACCOUNT_CHECK_INTERVAL_SECONDS=3600
PROACTIVE_ACCOUNT_CHECK_CONTEXT_MESSAGES=12
PROACTIVE_ACCOUNT_CHECK_MIN_CONFIDENCE=0.85
PROACTIVE_CONTENT_INVITATION_GENERATION_ENABLED=true
PROACTIVE_COMMITMENT_EXTRACTION_ENABLED=true
PROACTIVE_COMMITMENT_CONTEXT_MESSAGES=8
PROACTIVE_COMMITMENT_MIN_CONFIDENCE=0.9
PROACTIVE_COMMITMENT_MAX_DAYS=14

# Web search. Enable only after provider credentials and network access are verified.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_DEFAULT_PROVIDER=duckduckgo
WEB_SEARCH_PROVIDER_ORDER=duckduckgo,bing
WEB_SEARCH_PROVIDER_FAILOVER=true
WEB_SEARCH_SYNC_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TRACE_RAW_RESPONSE=false

# Aliyun IQS web search.
DASHSCOPE_API_KEY=
ALIYUN_WEB_SEARCH_API_KEY=
ALIYUN_WEB_SEARCH_ENABLED=false
ALIYUN_WEB_SEARCH_BASE_URL=https://cloud-iqs.aliyuncs.com/search/unified
ALIYUN_WEB_SEARCH_ENGINE_TYPE=LiteAdvanced
ALIYUN_WEB_SEARCH_MODEL=qwen-plus
ALIYUN_WEB_SEARCH_FORCED=true
ALIYUN_WEB_SEARCH_ENABLE_SOURCE=true
ALIYUN_WEB_SEARCH_STRATEGY=

# Baidu AI Search.
BAIDU_AI_SEARCH_ENABLED=false
BAIDU_AI_SEARCH_API_KEY=
BAIDU_AI_SEARCH_BASE_URL=https://qianfan.baidubce.com
BAIDU_AI_SEARCH_ENDPOINT=/v2/ai_search/web_search
BAIDU_AI_SEARCH_SOURCE=baidu_search_v2
BAIDU_AI_SEARCH_TOP_K=5

# Aliyun SMS. Required in production.
ALIYUN_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
ALIYUN_SMS_SIGN_NAME=CHANGE_ME
ALIYUN_SMS_TEMPLATE_CODE=CHANGE_ME
ALIYUN_SMS_MAX_PER_PHONE_PER_HOUR=5

# Aliyun Captcha 2.0. Required in production.
ALIYUN_CAPTCHA_SCENE_ID=CHANGE_ME
ALIYUN_CAPTCHA_PREFIX=CHANGE_ME

# OTP TTL.
OTP_EXPIRES_MINUTES=10
OTP_TOKEN_EXPIRES_MINUTES=10
