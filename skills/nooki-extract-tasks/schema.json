{
  "$version": "1.0",
  "type": "object",
  "required": ["title", "items"],
  "properties": {
    "title": {
      "type": "string",
      "description": "清单标题"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "firstMove", "suggestedMinutes"],
        "properties": {
          "title": {"type": "string", "description": "任务名"},
          "firstMove": {"type": "string", "description": "第一下是什么（具体动作，不超过15字）"},
          "suggestedMinutes": {"type": "number", "minimum": 1}
        }
      }
    }
  }
}
