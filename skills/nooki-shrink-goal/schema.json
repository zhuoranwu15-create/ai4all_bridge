{
  "$version": "1.0",
  "type": "object",
  "required": ["microGoal", "firstStep", "estimatedMinutes", "options", "successCriteria"],
  "properties": {
    "microGoal": {"type": "string", "description": "缩小后的目标（一句话）"},
    "firstStep": {"type": "string", "description": "第一下（来自超小步的 firstMove）"},
    "estimatedMinutes": {"type": "number", "minimum": 1},
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["level", "label", "title", "firstMove", "suggestedMinutes"],
        "properties": {
          "level": {"type": "string", "enum": ["tiny", "light", "normal"]},
          "label": {"type": "string"},
          "title": {"type": "string"},
          "firstMove": {"type": "string"},
          "suggestedMinutes": {"type": "number", "minimum": 1}
        }
      }
    },
    "successCriteria": {"type": "string"}
  }
}
